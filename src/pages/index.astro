---
// Importing a Layout is just a JS import — same as importing a module in
// any React/Vue project. Astro components can import other Astro components.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Amapal Inc." description="work in progress">
	<main>
		<img class="logo" src="/images/logo.png" alt="Amapal Inc. Dairy Consultants" />
		<p>work in progress</p>
	</main>
</BaseLayout>

<style>
	main {
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 2rem;
	}
	.logo {
		height: 100px;
		width: auto;
		display: block;
	}
	p {
		color: #666;
		font-size: 0.95rem;
		margin: 0;
	}
</style>
