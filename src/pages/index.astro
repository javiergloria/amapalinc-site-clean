---
// Importing a Layout is just a JS import — same as importing a module in
// any React/Vue project. Astro components can import other Astro components.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="amapalinc.com" description="work in progress">
	<main>
		<h1>amapalinc.com</h1>
		<p>work in progress</p>
	</main>
</BaseLayout>

<style>
	main {
		padding: 2rem;
	}
	h1 {
		font-size: 1.1rem;
		font-weight: 400;
		letter-spacing: 0.02em;
		margin-bottom: 0.5rem;
	}
	p {
		color: #666;
		font-size: 0.95rem;
	}
</style>
